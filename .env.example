VITE_APP_NAME=Tax Jiffy
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_BASE_URL=ws://api.taxjiffy.com/ws

# Dev-server only (not exposed to the client): Vite proxy target for /api, /uploads and /ws.
# Defaults to https://api.taxjiffy.com when unset. Set in .env.local to use a local backend.
API_PROXY_TARGET=http://localhost:7071
